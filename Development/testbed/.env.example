# =====================================================================
#  The same .env on every machine. Usually only ROLE differs.
# =====================================================================

# som = SOM machine | cam = CAM machine | all = SOM + CAM on one machine (dev)
ROLE=all

# IP of the CAM machine (used by the SOM bridge, check.sh and outage.sh link).
# Ignored with ROLE=all. Use a fixed IP / DHCP reservation, not "rpi-1.local":
# containers cannot resolve mDNS names.
CAM_IP=192.168.1.20

# Optional: IP of the SOM machine, only so check.sh can also be run on CAM
SOM_IP=192.168.1.10

# sim = fake Lunatico/Alcor data (SOM side). Empty it once real devices are connected.
COMPOSE_PROFILES=sim

# --- dev passwords: CHANGE before putting this on a real network (same on both machines)
DEVICE_PASS=CHANGE_ME
BRIDGE_PASS=CHANGE_ME
NODERED_MQTT_PASS=CHANGE_ME
# Grafana user "admin"; only applied when Grafana starts for the first time
GRAFANA_ADMIN_PASS=CHANGE_ME

# =====================================================================
#  Rarely changed
# =====================================================================
COMPOSE_FILE=compose.${ROLE:-all}.yml

MOSQUITTO_VERSION=2.0.22
INFLUX_VERSION=1.12
NODERED_VERSION=4.0
GRAFANA_VERSION=11.6.0
INFLUX_DB=wrwo
# simulator: Alcor/telegraf every SIM_INTERVAL s, CloudWatcher every SIM_CW_INTERVAL s
SIM_INTERVAL=10
SIM_CW_INTERVAL=10
BRIDGE_MAX_QUEUED_BYTES=500000000
# seconds; SOM->CAM link loss is noticed after ~1.5x this (Mosquitto default 60)
BRIDGE_CAM_KEEPALIVE=20

# Node-RED runs as this uid:gid so files it writes in ./nodered belong to you
# (check on the Pi with: id -u ; id -g)
NODERED_UID=1000
NODERED_GID=1000

# host ports (SOM and CAM differ so ROLE=all fits on one machine)
BRIDGE_PORT=1883
SOM_BROKER_PUBLISH_PORT=1884
CAM_BROKER_PUBLISH_PORT=1885
SOM_NODERED_PORT=1880
CAM_NODERED_PORT=1881
SOM_INFLUX_PORT=8086
CAM_INFLUX_PORT=8087
SOM_GRAFANA_PORT=3000
CAM_GRAFANA_PORT=3001
