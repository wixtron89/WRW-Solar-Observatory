        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "cloudwatcher",
          "query": "SELECT sum(\"qc_rejected\") FROM \"cloudwatcher\" WHERE $timeFilter"
        },
        {
          "refId": "B",
          "rawQuery": true,
          "resultFormat": "time_series",
