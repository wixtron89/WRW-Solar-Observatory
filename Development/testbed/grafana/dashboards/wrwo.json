{
  "uid": "wrwo-telemetry",
  "title": "WRW telemetry",
  "tags": [
    "wrwo"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "schemaVersion": 39,
  "version": 4,
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Pipeline (SOM → CAM)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Points / last minute",
      "datasource": {
        "type": "influxdb",
        "uid": "influx-wrwo"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "seeing",
          "query": "SELECT count(\"delay_s\") FROM \"seeing\" WHERE time > now() - 1m"
        },
        {
          "refId": "B",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "cloudwatcher",
          "query": "SELECT count(\"delay_s\") FROM \"cloudwatcher\" WHERE time > now() - 1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "description": "Simulator default: seeing 30 (every 2 s), cloudwatcher 2 (every 30 s). 0 = no data arriving."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Latest delay",
      "datasource": {
        "type": "influxdb",
        "uid": "influx-wrwo"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "seeing",
          "query": "SELECT last(\"delay_s\") FROM \"seeing\" WHERE $timeFilter"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      },
      "description": "Arrival time at Node-RED minus the MQ-BRIDGE plugin timestamp. Large after a SOM-CAM link outage."
    },
    {
      "id": 4,
