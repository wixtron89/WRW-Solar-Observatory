        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "description": "ts_source=nodered: message did not pass MQ-BRIDGE or the plugin is not loaded. Must be 0."
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Delay (delay_s)",
      "datasource": {
        "type": "influxdb",
        "uid": "influx-wrwo"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "cloudwatcher",
          "query": "SELECT max(\"delay_s\") FROM \"cloudwatcher\" WHERE $timeFilter GROUP BY time($__interval) fill(null)"
        },
        {
          "refId": "B",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "seeing",
          "query": "SELECT max(\"delay_s\") FROM \"seeing\" WHERE $timeFilter GROUP BY time($__interval) fill(null)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "interval": "30s",
      "description": "Normally < 1 s. After a link outage: a spike as high as the outage was long, then back down."
    },
